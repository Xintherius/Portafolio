      <aliases enabled='yes' />
      <column caption='Max Date' datatype='datetime' name='[Calculation_2409620238061568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([InvoiceDate])' />
      </column>
      <column caption='Recency' datatype='integer' name='[Calculation_2409620238254081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [CustomerID] : MAX([InvoiceDate])}, {MAX([InvoiceDate])})' />
      </column>
      <column caption='Monetary' datatype='real' name='[Calculation_2409620239388674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [CustomerID] : SUM([totalPrice])}' />
      </column>
      <column caption='Frequency' datatype='integer' name='[Calculation_2409620239593475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [CustomerID]:COUNTD(InvoiceNo)}' />
      </column>
      <column caption='Customer Segmentation' datatype='string' name='[Calculation_2409620240646148]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2409620239593475] &lt; 6 AND [Calculation_2409620238254081] &lt;= 30 THEN &quot;Low Frequency Promising&quot;&#13;&#10;ELSEIF [Calculation_2409620239593475] &lt; 6 AND [Calculation_2409620238254081] &gt; 30 THEN &quot;Low Frequency At Risk&quot;&#13;&#10;ELSEIF [Calculation_2409620239593475] &lt; 13 AND [Calculation_2409620238254081] &lt;= 30 THEN &quot;Medium Frequency Promising&quot;&#13;&#10;ELSEIF [Calculation_2409620239593475] &lt; 13 AND [Calculation_2409620238254081] &gt; 30 THEN &quot;Medium Frequency At Risk&quot;&#13;&#10;ELSEIF [Calculation_2409620239593475] &lt; 51 THEN &quot;High Frequency&quot;&#13;&#10;ELSE &quot;Very High Frequency&quot;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Customer ID' datatype='string' name='[CustomerID]' role='dimension' type='nominal' />
      <column caption='Invoice Date' datatype='datetime' name='[InvoiceDate]' role='dimension' type='ordinal' />
      <column caption='Invoice No' datatype='string' name='[InvoiceNo]' role='dimension' type='nominal' />
      <column caption='Stock Code' datatype='string' name='[StockCode]' role='dimension' type='nominal' />
      <column caption='Unit Price' datatype='real' name='[UnitPrice]' role='measure' type='quantitative' />
