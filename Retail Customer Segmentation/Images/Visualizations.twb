    <worksheet name='Customer Retention &amp; Spend Risk by Discount Status'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Bold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_online_retail (retail)' name='federated.1kfip9705zfkog18drzo41645r86' />
          </datasources>
          <datasource-dependencies datasource='federated.1kfip9705zfkog18drzo41645r86'>
            <column caption='Recency' datatype='integer' name='[Calculation_2409620238254081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [CustomerID] : MAX([InvoiceDate])}, {MAX([InvoiceDate])})' />
            </column>
            <column caption='Monetary' datatype='real' name='[Calculation_2409620239388674]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [CustomerID] : SUM([totalPrice])}' />
            </column>
            <column caption='Frequency' datatype='integer' name='[Calculation_2409620239593475]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [CustomerID]:COUNTD(InvoiceNo)}' />
            </column>
            <column caption='Customer Segmentation' datatype='string' name='[Calculation_2409620240646148]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_2409620239593475] &lt; 6 AND [Calculation_2409620238254081] &lt;= 70 THEN &quot;Low Frequency Promising&quot;&#13;&#10;ELSEIF [Calculation_2409620239593475] &lt; 6 AND [Calculation_2409620238254081] &gt; 70 THEN &quot;Low Frequency At Risk&quot;&#13;&#10;ELSEIF [Calculation_2409620239593475] &lt; 13 AND [Calculation_2409620238254081] &lt;= 70 THEN &quot;Medium Frequency Promising&quot;&#13;&#10;ELSEIF [Calculation_2409620239593475] &lt; 13 AND [Calculation_2409620238254081] &gt; 70 THEN &quot;Medium Frequency At Risk&quot;&#13;&#10;ELSEIF [Calculation_2409620239593475] &lt; 51 THEN &quot;High Frequency&quot;&#13;&#10;ELSE &quot;Very High Frequency&quot;&#13;&#10;END' />
            </column>
            <column caption='Discount Status' datatype='string' name='[Calculation_2409620261617676]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Discounted] = 1, &quot;Used Discount&quot;, &quot;No Discount&quot;)' />
            </column>
            <column caption='Customer ID' datatype='string' name='[CustomerID]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Discounted]' role='measure' type='quantitative' />
            <column caption='Invoice Date' datatype='datetime' name='[InvoiceDate]' role='dimension' type='ordinal' />
            <column caption='Invoice No' datatype='string' name='[InvoiceNo]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2409620239388674]' derivation='None' name='[none:Calculation_2409620239388674:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2409620240646148]' derivation='None' name='[none:Calculation_2409620240646148:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2409620261617676]' derivation='None' name='[none:Calculation_2409620261617676:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2409620238254081]' derivation='Sum' name='[sum:Calculation_2409620238254081:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2409620239388674]' derivation='Sum' name='[sum:Calculation_2409620239388674:qk]' pivot='key' type='quantitative' />
            <column caption='Total Price' datatype='real' name='[totalPrice]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1kfip9705zfkog18drzo41645r86].[none:Calculation_2409620239388674:qk]' included-values='in-range'>
